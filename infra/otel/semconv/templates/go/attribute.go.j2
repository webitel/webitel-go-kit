{%- macro gosym(name) -%}
{%- for part in name | split(".") -%}{{ part | pascal_case | acronym }}{%- endfor -%}
{%- endmacro -%}
{#- Go identifiers must NOT move when the namespace changes: pgx and every
    other consumer references them by name. So the namespace is stripped and
    replaced with a fixed "Webitel", leaving the prefix visible only in the
    wire value. -#}
{%- macro symbol(name) -%}
{%- set prefix = params.namespace ~ "." -%}
{%- if name is startingwith(prefix) -%}
{#- prefix-anchored on purpose: a bare `replace` also strips the namespace from
    the MIDDLE of upstream names, which mislabels them as ours. -#}
Webitel{{ gosym(name[prefix|length:]) }}
{%- else -%}{{ gosym(name) }}{%- endif -%}
{%- endmacro -%}
